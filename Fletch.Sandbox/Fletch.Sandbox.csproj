<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.bmp" />
    <None Remove="Icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
	<ItemGroup>
		<Content Include="Assets\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fletch.Application\Fletch.Application.csproj" />
    <ProjectReference Include="..\Fletch.Assets\Fletch.Assets.csproj" />
    <ProjectReference Include="..\Fletch.Audio\Fletch.Audio.csproj" />
    <ProjectReference Include="..\Fletch.Core\Fletch.Core.csproj" />
    <ProjectReference Include="..\Fletch.Engine\Fletch.Engine.csproj" />
    <ProjectReference Include="..\Fletch.Hosting\Fletch.Hosting.csproj" />
    <ProjectReference Include="..\Fletch.Input\Fletch.Input.csproj" />
    <ProjectReference Include="..\Fletch.Physics\Fletch.Physics.csproj" />
    <ProjectReference Include="..\Fletch.Platform.MonoGame\Fletch.Platform.MonoGame.csproj" />
    <ProjectReference Include="..\Fletch.Platform\Fletch.Platform.csproj" />
    <ProjectReference Include="..\Fletch.Rendering\Fletch.Rendering.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="OpenAL32.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Assets\" />
  </ItemGroup>
</Project>